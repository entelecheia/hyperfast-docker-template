name: release

on:
  push:
    branches: [main]
    paths-ignore: ["**.md"]
  workflow_dispatch:

# Releases are never cancelled; a later push waits.
concurrency:
  group: release

jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    outputs:
      released: {% raw %}${{ steps.psr.outputs.released }}{% endraw %}
      version: {% raw %}${{ steps.psr.outputs.version }}{% endraw %}
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      # Tag only (no commit), so a protected main branch does not block the release.
      - id: psr
        uses: python-semantic-release/python-semantic-release@v10.7.0
        with:
          github_token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          commit: false
          changelog: false
          build: false
{%- if kind == 'workspace' or build %}

  image:
    # A tag pushed with GITHUB_TOKEN does not trigger other workflows, so images build here.
    needs: release
    if: needs.release.outputs.released == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 90
    permissions:
      contents: read
      packages: write
    strategy:
      fail-fast: false
      matrix:
        variant: {{ variants | tojson }}
    steps:
      - uses: actions/checkout@v7
      - name: Free runner disk for CUDA base images
        if: {% raw %}${{ startsWith(matrix.variant, 'cuda') }}{% endraw %}
        run: sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
      - id: base
        run: echo "image=$(sed -n 's/^BASE_IMAGE=//p' .docker/variants/{% raw %}${{ matrix.variant }}{% endraw %}.env)" >> "$GITHUB_OUTPUT"
      - uses: docker/setup-buildx-action@v4
      - uses: docker/login-action@v4
        with:
          registry: {{ registry }}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - uses: docker/build-push-action@v7
        with:
          context: .
          file: .docker/Dockerfile
          build-args: BASE_IMAGE={% raw %}${{ steps.base.outputs.image }}{% endraw %}
          push: true
          # Versioned tags only; consumers pin a version or digest.
          tags: {{ registry }}/{{ owner }}/{{ project_name }}:{% raw %}${{ needs.release.outputs.version }}-${{ matrix.variant }}{% endraw %}
          cache-from: type=gha,scope={% raw %}${{ matrix.variant }}{% endraw %}
          cache-to: type=gha,mode=max,scope={% raw %}${{ matrix.variant }}{% endraw %}
{%- endif %}
