.DEFAULT_GOAL := help
INSTANCE ?= example
# The instance name always comes from the command line, so copied env files cannot collide.
export INSTANCE
ENV_FILE ?= instances/$(INSTANCE).env
{%- if kind == 'workspace' or build %}
VARIANT ?= $(shell sed -n 's/^VARIANT=//p' $(ENV_FILE))
VARIANT_FILE := .docker/variants/$(VARIANT).env
VARIANTS := $(basename $(notdir $(wildcard .docker/variants/*.env)))
COMPOSE := docker compose --env-file $(VARIANT_FILE) --env-file $(ENV_FILE)
{%- else %}
COMPOSE := docker compose --env-file $(ENV_FILE)
{%- endif %}

.PHONY: help check build up down logs ps

help: ## show targets
	@awk 'BEGIN {FS = ":.*## "} /^[a-z-]+:.*## / {printf "  %-8s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

check: ## compose rules{% if kind == 'workspace' or build %}, Dockerfile checks per variant{% endif %}, shellcheck (exits non-zero on failure)
{%- if kind == 'workspace' or build %}
	ENV_FILE=$(ENV_FILE) VARIANT_FILE=$(VARIANT_FILE) scripts/check-compose.sh
	@for v in $(VARIANTS); do \
	  base=$$(sed -n 's/^BASE_IMAGE=//p' .docker/variants/$$v.env); \
	  echo "docker build --check ($$v)"; \
	  docker build --check --build-arg BASE_IMAGE=$$base -f .docker/Dockerfile . || exit 1; \
	done
	shellcheck scripts/*.sh{% if kind == 'workspace' %} .docker/entrypoint.sh{% endif %}
{%- else %}
	ENV_FILE=$(ENV_FILE) scripts/check-compose.sh
	shellcheck scripts/*.sh
{%- endif %}
{%- if kind == 'workspace' or build %}

build: ## build the image for VARIANT (from the instance file)
	$(COMPOSE) build
{%- endif %}

up: ## start INSTANCE in the background and wait for healthy
	$(COMPOSE) up -d --wait

down: ## stop and remove INSTANCE containers; volumes and data stay
	$(COMPOSE) down

logs: ## follow INSTANCE logs
	$(COMPOSE) logs -f --tail 200

ps: ## show INSTANCE status
	$(COMPOSE) ps
