# Copy to instances/<name>.env (gitignored) and fill in; run with `make up INSTANCE=<name>`.
# Prefix for the compose project, containers, network and volumes (use your user name).
NAME_PREFIX=change-me
{%- if kind == 'workspace' or build %}
# One of .docker/variants/*.env; IMAGE_TAG is <version>-<variant> for published images.
VARIANT={{ variants[0] }}
IMAGE_TAG=0.0.0-{{ variants[0] }}
# Match the host account that owns DATA_ROOT (id -u / id -g). Published images use 1000;
# other ids need a local build (make build). Changing ids later needs a fresh home volume.
USER_UID=1000
USER_GID=1000
{%- endif %}
# Loopback by default; reach it with ssh -L. Only the workspace SSH port may be public.
BIND_ADDR=127.0.0.1
{%- if kind == 'workspace' %}
HOST_SSH_PORT=2222
# authorized_keys file mounted read-only; password login is disabled.
AUTHORIZED_KEYS=/path/to/authorized_keys
{%- else %}
HOST_PORT=18000
{%- endif %}
# Existing directory on the large data disk; mounted at /data (HF cache in /data/cache).
DATA_ROOT=/path/to/data-disk/change-me/{{ project_name }}
{%- if gpu %}
# GPU UUIDs from `nvidia-smi -L`, comma-separated. Check which GPUs are free first.
GPU_UUIDS=GPU-00000000-0000-0000-0000-000000000000
{%- endif %}
CPUS=16
MEMORY=32g
SHM_SIZE=8g
